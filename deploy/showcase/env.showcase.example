# Copy to deploy/showcase/.env.showcase and fill in a secret. Values below are
# the CONCRETE showcase scheme for pavankarthick.in (free Cloudflare Universal
# SSL covers the apex + one level of subdomain, *.pavankarthick.in).
#
# Load before running the bootstrap:
#   set -a; source deploy/showcase/.env.showcase; set +a
#
# Scheme (all ONE level under the apex, so all covered by free TLS):
#   pavankarthick.in            -> null root directory
#   delhi.pavankarthick.in      -> Delhi chapter
#   bangalore.pavankarthick.in  -> Bangalore chapter
#   goa.pavankarthick.in        -> Goa chapter
#
# NOTE: the root directory is served at the APEX, so routing the apex through
# the tunnel temporarily replaces whatever pavankarthick.in shows today. Stop
# the tunnel (or drop the apex route) to restore it. See README "Heads-up".

ROOT_DOMAIN=pavankarthick.in
SITE_BASE_URL=https://pavankarthick.in

DJANGO_SETTINGS_MODULE=config.settings.showcase
DJANGO_SECRET_KEY=CHANGE-ME-to-a-long-random-string
ALLOWED_HOSTS=.pavankarthick.in
SESSION_COOKIE_DOMAIN=.pavankarthick.in
CSRF_COOKIE_DOMAIN=.pavankarthick.in

# MySQL + Redis from docker-compose (published on host ports 3307 / 6380)
MYSQL_SERVER=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=swachalit
MYSQL_USERNAME=root
MYSQL_PASSWORD=s0m3p4ssw0rd
REDIS_URL=redis://127.0.0.1:6380/0

# Optional: real email delivery (else emails print to the gunicorn log, which
# is the recommended demo default — visible + works for all seeded users).
# Setting MAILGUN_API_KEY switches the backend to Mailgun/anymail automatically.
# CAVEAT: a Mailgun *sandbox* domain (sandbox....mailgun.org) can only send to
# pre-AUTHORIZED recipients, so seeded members (memberN@example.com) are
# rejected — use a verified domain for real attendee mail. Rotate any key you
# have shared in plaintext.
# MAILGUN_API_KEY=
# MAILGUN_SENDER_DOMAIN=your-domain-or-sandbox.mailgun.org
# DEFAULT_FROM_EMAIL=postmaster@your-domain-or-sandbox.mailgun.org

# Optional: force TOTP 2FA on admins/leads to demo the Trust & Safety feature.
# REQUIRE_2FA_FOR_PRIVILEGED=1
