# Copy to deploy/showcase/.env.showcase and fill in your domain + a secret.
# Load before running the bootstrap:
#   set -a; source deploy/showcase/.env.showcase; set +a
#
# IMPORTANT: use your Cloudflare ZONE APEX as ROOT_DOMAIN (e.g. example.com),
# so chapters are ONE level deep (delhi.example.com) and covered by
# Cloudflare's free Universal SSL wildcard (*.example.com). A two-level root
# like null.example.com makes chapters delhi.null.example.com — NOT covered
# by Universal SSL (needs paid Advanced Certificate Manager).

ROOT_DOMAIN=example.com
SITE_BASE_URL=https://example.com

DJANGO_SETTINGS_MODULE=config.settings.showcase
DJANGO_SECRET_KEY=CHANGE-ME-to-a-long-random-string
ALLOWED_HOSTS=.example.com
SESSION_COOKIE_DOMAIN=.example.com
CSRF_COOKIE_DOMAIN=.example.com

# MySQL + Redis from docker-compose (published on host ports 3307 / 6380)
MYSQL_SERVER=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=swachalit
MYSQL_USERNAME=root
MYSQL_PASSWORD=s0m3p4ssw0rd
REDIS_URL=redis://127.0.0.1:6380/0

# Optional: real email delivery (else emails print to the gunicorn log).
# MAILGUN_API_KEY=
# MAILGUN_SENDER_DOMAIN=example.com

# Optional: force TOTP 2FA on admins/leads to demo the Trust & Safety feature.
# REQUIRE_2FA_FOR_PRIVILEGED=1
